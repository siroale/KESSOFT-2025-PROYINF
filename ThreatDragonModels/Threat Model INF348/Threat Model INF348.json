              "isWebApplication": false,
              "privilegeLevel": "",
              "threats": [
                {
                  "id": "e66dda90-e8c3-498a-8b73-f90c43b8f201",
                  "title": "BOLA/IDOR en la API",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "Un atacante autenticado podría modificar o eliminar un \"Boletín\" o \"Usuario\" que no le pertenece, manipulando el ID en la URL de la API (ej. PUT /api/boletines/5/), si el backend no verifica correctamente la propiedad del recurso.",
                  "mitigation": "Implementar validación de permisos a nivel de objeto en views.py (ej. usando IsOwnerOrReadOnly en Django REST Framework) verificando que request.user coincida con el creador del boletín antes de procesar la acción.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "9b0f2e8e-176d-4a12-b333-dc607e5fb7f9",
                  "title": "Subida de archivos maliciosos sin restricción",
                  "status": "Open",
                  "severity": "High",
                  "type": "Denial of service",
                  "description": "El endpoint de creación permite subir archivos sin validar rigurosamente su tipo MIME real ni su tamaño límite. Un atacante podría subir scripts ejecutables (web shells) o saturar el almacenamiento del servidor subiendo archivos gigantes (DoS).",
                  "mitigation": "Validar estrictamente la extensión y el content-type de los archivos subidos. Forzar un renombramiento aleatorio del archivo al guardar y limitar DATA_UPLOAD_MAX_MEMORY_SIZE en la configuración de Django.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "4512dc1f-3d69-4d77-bbbf-416c4cd51abb",
                  "title": "Exposición de SECRET_KEY en el código fuente",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "La SECRET_KEY de Django está expuesta en el archivo README.md o en el control de versiones. Un atacante puede usarla para falsificar cookies de sesión, firmar tokens fraudulentos y potencialmente tomar control total de la aplicación ejecutando código remoto.",
                  "mitigation": "Eliminar la llave del repositorio inmediatamente. Generar una nueva llave segura y cargarla en el entorno de producción únicamente a través de variables de entorno (.env) que estén excluidas en el .gitignore.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                }
              ],
              "threatFrequency": {
                "spoofing": 2,
                "tampering": 0,
                "repudiation": 0,
                "informationDisclosure": 0,
                "denialOfService": 1,
                "elevationOfPrivilege": 1
              }
            },
