              "threats": [
                {
                  "id": "b56dec01-402a-41ed-9c73-13967ab776b4",
                  "title": "Cross-Site Scripting (XSS) Almacenado",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "Los campos de texto de los Boletines no se sanitizan. Un atacante puede inyectar scripts JavaScript maliciosos que se guardan en la base de datos y luego se ejecutan automáticamente en el navegador de otros usuarios (o administradores) al visualizar el boletín, permitiendo el robo de sesiones.",
                  "mitigation": "Sanitizar la entrada de datos en el backend (usando librerías como bleach). En el frontend, asegurar que React escape los datos por defecto y evitar estrictamente el uso de funciones como dangerouslySetInnerHTML con contenido provisto por usuarios.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                }
              ],
              "threatFrequency": {
                "spoofing": 2,
                "tampering": 0,
